---
import FormattedDate from './FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

// yyyy/MM/dd/slug のURLを生成
const pubDate = new Date(post.data.pubDate);
const year = pubDate.getFullYear().toString();
const month = String(pubDate.getMonth() + 1).padStart(2, '0');
const day = String(pubDate.getDate()).padStart(2, '0');
const slug = post.data.slug || post.id.replace(/\.[^/.]+$/, "").split("/").pop();
const href = `/${year}/${month}/${day}/${slug}`;
---

<article class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow flex flex-col h-full group">
  {
    post.data.heroImage ? (
      <a href={href} class="block aspect-video overflow-hidden bg-gray-100">
        <img
          src={post.data.heroImage}
          alt={post.data.title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
        />
      </a>
    ) : (
      <a href={href} class="block aspect-video bg-gradient-to-br from-sky-100 to-indigo-50 flex items-center justify-center text-4xl">
        📖
      </a>
    )
  }
  <div class="p-6 flex-1 flex flex-col">
    <div class="flex items-center space-x-2 text-xs text-gray-500 mb-3">
      <FormattedDate date={post.data.pubDate} />
      {post.data.categories && post.data.categories.length > 0 && (
        <>
          <span>•</span>
          <span class="text-sky-600 font-medium">{post.data.categories[0]}</span>
        </>
      )}
    </div>
    <h2 class="text-lg font-bold text-gray-900 group-hover:text-sky-600 transition-colors mb-2 line-clamp-2 leading-snug">
      <a href={href}>
        {post.data.title}
      </a>
    </h2>
    {post.data.description && (
      <p class="text-sm text-gray-600 line-clamp-2 mb-4 flex-1">
        {post.data.description}
      </p>
    )}
    {post.data.tags && post.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mt-auto pt-4 border-t border-gray-50">
        {post.data.tags.slice(0, 3).map((tag: string) => (
          <a
            href={`/tags/${encodeURIComponent(tag)}`}
            class="text-xs bg-gray-100 text-gray-600 hover:bg-sky-50 hover:text-sky-600 px-2 py-0.5 rounded transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}
  </div>
</article>
