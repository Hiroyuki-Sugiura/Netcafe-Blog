---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  filteredHeadings.length > 0 && (
    <nav class="bg-gray-50 border border-gray-200 rounded-xl p-6 my-8">
      <div class="flex items-center space-x-2 font-bold text-gray-800 mb-4 pb-2 border-b border-gray-200">
        <svg class="w-5 h-5 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
        </svg>
        <span>目次</span>
      </div>
      <ul class="space-y-2 text-sm">
        {filteredHeadings.map((heading) => (
          <li class={heading.depth === 3 ? "ml-4 text-gray-600" : "font-medium text-gray-800"}>
            <a href={`#${heading.slug}`} class="hover:text-sky-600 hover:underline transition-colors block py-0.5">
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
